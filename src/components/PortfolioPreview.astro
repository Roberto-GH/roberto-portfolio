---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, slug } = Astro.props.project;
const [es, ...sluges] = slug.split('/');
const isCssBackground = data.img === 'css';
---
<a class:list={["card", { "css-bg": isCssBackground }]} href={`/${lang}/work/${sluges.join('/')}`}>	
	{!isCssBackground && <img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />}
	{isCssBackground && <div class="project-image-container"><img src={data.imgRes} alt={data.img_alt || ''} loading="lazy" decoding="async" class="contained-img" /></div>}
	<span class="title">{data.title}</span>
</a>

<style>
	.project-image-container {
		grid-area: 1 / 1 / 2 / 2;
		display: flex;
		justify-content: center;
		align-items: center;
		width: 100%;
		height: 100%;
		z-index: 0;
	}

	.contained-img {
		max-width: 60%;
		max-height: 60%;
		object-fit: contain;
	}

	.card {
		display: grid;
		grid-template: 1fr / 1fr;
		height: 22rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 500;
		transition: box-shadow var(--theme-transition);		
	}

	.card.css-bg {
		background: var(--gradient-accent);
	}

	.card:hover {
		box-shadow: var(--shadow-md);
	}

	.title {
		grid-area: 1 / 1 / 2 / 2;
		justify-self: start;
		align-self: start;
		z-index: 1;
		margin: 0.5rem;
		padding: 0.5rem 1rem;
		background: var(--gray-999);
		color: var(--gray-200);
		border-radius: 0.375rem;
	}

	img {
		grid-area: 1 / 1 / 2 / 2;
		width: 100%;
		height: 100%;
		object-fit: contain;
		z-index: 0;
	}

	@media (min-width: 50em) {
		.card {
			height: 22rem;
			border-radius: 1.5rem;
		}

		.title {
			border-radius: 0.9375rem;
		}
	}
</style>
